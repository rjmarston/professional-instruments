---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import Facts from '../components/Facts.astro';
import ArrowLink from '../components/ArrowLink.astro';
import { about } from '../data/about';

const h = about.history;
const years = Array.from({ length: h.to - h.from + 1 }, (_, i) => h.from + i);
const pos = (y: number) => `${(((y - h.from) / (h.to - h.from)) * 100).toFixed(3)}%`;
const eraLabel = (a: number, b: number) => `${a}–${b === h.to ? 'today' : b}`;
---

<Base fullTitle={about.seoTitle} description={about.seoDescription} active="about">
  <PageHead title={about.title} lede={about.lede} crumbs={[{ label: 'Home', href: '/' }, { label: 'About' }]} />

  <section id="company" class="sec sec-first wrap" aria-labelledby="co-h">
    <div class="in">
      <SectionHead id="co-h" title={about.company.title} />
      <div class="ov">
        <div class="ov-t">{about.company.paragraphs.map((p) => <p>{p}</p>)}</div>
        <figure class="photo"><div class="frame"><img src={about.company.photo.src} alt={about.company.photo.alt} width={about.company.photo.width} height={about.company.photo.height} loading="lazy" /></div></figure>
      </div>
    </div>
  </section>

  <section id="history" class="sec anchor wrap" aria-labelledby="hi-h">
    <div class="in">
      <SectionHead id="hi-h" title={h.title} />
      <div class="hist reveal">
        <div class="yr" data-from={h.from} data-to={h.to}>
          <div class="yr-read" aria-hidden="true"><span class="yr-y">{h.from}</span></div>
          <svg class="yr-svg" width="100%" height="44" aria-hidden="true" overflow="visible">
            <line x1="0" y1="0.5" x2="100%" y2="0.5" class="yr-base"></line>
            {years.map((y) => {
              const era = h.eras.some((e) => e.from === y) || y === h.to, dec = y % 10 === 0;
              return (
                <>
                  <line x1={pos(y)} y1="0" x2={pos(y)} y2={era ? 26 : dec ? 12 : 6} class={era ? 'yr-end' : dec ? 'yr-dec' : 'yr-min'}></line>
                  {dec && !era && <text x={pos(y)} y="40" text-anchor="middle" class="yr-lab">{y}</text>}
                </>
              );
            })}
            <circle cx={pos(h.milestone)} cy="0.5" r="3.5" class="yr-ms"></circle>
          </svg>
          <span class="yr-ix" aria-hidden="true"></span>
        </div>
        <ol class="eras">
          {h.eras.map((e) => (
            <li class="era" data-from={e.from} data-to={e.to}>
              <span class="era-y">{eraLabel(e.from, e.to)}</span>
              <p>{e.text}</p>
              {e.note && <p class="era-n">{e.note}</p>}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section id="shop" class="sec anchor wrap" aria-labelledby="sh-h">
    <div class="in">
      <SectionHead id="sh-h" title={about.shop.title} intro={about.shop.intro} />
      <div class="shop">
        {about.shop.photos.map((p) => <figure class="photo"><div class="frame"><img src={p.src} alt={p.alt} width={p.width} height={p.height} loading="lazy" /></div></figure>)}
      </div>
      <div class="ov">
        <div class="ov-t"><p>{about.shop.text}</p></div>
        <Facts items={about.shop.facts} class="facts-2" />
      </div>
    </div>
  </section>

  <section id="research" class="sec anchor wrap" aria-labelledby="rs-h">
    <div class="in">
      <SectionHead id="rs-h" title={about.research.title} intro={about.research.intro} />
      <div class="ov">
        <ul class="lst posters">
          {about.research.posters.map((p) => <li><span class="py">{p.year} · {p.event}</span><span>{p.title}</span></li>)}
        </ul>
        <div class="ov-t"><p>{about.research.text}</p><ArrowLink label={about.research.cta.label} href={about.research.cta.href} /></div>
      </div>
    </div>
  </section>
</Base>

<script>
  // History: a red index travels the year scale as you scroll, and the era it's in turns dark.
  const yr = document.querySelector<HTMLElement>('#history .yr');
  if (yr) {
    const ix = yr.querySelector<HTMLElement>('.yr-ix')!, read = yr.querySelector<HTMLElement>('.yr-read')!, label = yr.querySelector<HTMLElement>('.yr-y')!;
    const eras = [...document.querySelectorAll<HTMLElement>('.era')];
    const from = Number(yr.dataset.from), to = Number(yr.dataset.to);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
    const update = () => {
      const r = yr.getBoundingClientRect(), vh = window.innerHeight;
      if (r.top > vh * 1.2 || r.bottom < -vh * 0.5) return;
      const p = reduce.matches ? 1 : clamp((vh * 0.85 - r.top) / (vh * 0.6), 0, 1), x = p * r.width, y = from + Math.round((to - from) * p);
      const hw = label.offsetWidth / 2, rx = clamp(x, hw, r.width - hw);
      ix.style.transform = `translateX(${x.toFixed(1)}px)`;
      read.style.transform = `translateX(${rx.toFixed(1)}px)`;
      label.textContent = String(y);
      eras.forEach((e) => {
        const a = Number(e.dataset.from), b = Number(e.dataset.to);
        e.classList.toggle('on', y >= a && (y < b || b === to));
      });
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style is:global>
.ov{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:113px;row-gap:40px;align-items:start}
.ov-t{display:flex;flex-direction:column;gap:20px;font-size:17px;line-height:1.65}
.ov-t p{margin:0;max-width:34em}
@media (max-width:960px){.ov{grid-template-columns:minmax(0,1fr)}}
/* history on the year scale */
.hist{display:flex;flex-direction:column;gap:0;overflow-x:clip}
.yr{position:relative;margin-top:56px}
.yr-svg{display:block;overflow:visible}
.yr-base{stroke:var(--ink);stroke-width:1}
.yr-min{stroke:var(--rule);stroke-width:1}
.yr-dec{stroke:var(--graphite);stroke-width:1}
.yr-end{stroke:var(--ink);stroke-width:1}
.yr-ms{fill:var(--white);stroke:var(--ink);stroke-width:1}
.yr-lab{font-family:var(--mono);font-size:12px;fill:var(--graphite)}
.yr-ix{position:absolute;left:0;top:-14px;width:1.5px;height:42px;margin-left:-.75px;background:var(--red);will-change:transform}
.yr-read{position:absolute;left:0;width:0;bottom:calc(100% + 16px);will-change:transform}
.yr-y{display:block;width:max-content;transform:translateX(-50%);font-family:var(--mono);font-size:13px;color:var(--red);font-variant-numeric:tabular-nums}
.eras{list-style:none;margin:28px 0 0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
.era{display:flex;flex-direction:column;gap:10px;padding:0 28px 0 0;color:var(--graphite);transition:color .3s ease}
.era+.era{padding-left:0}
.era-y{font-family:var(--mono);font-size:13px;letter-spacing:.02em}
.era p{margin:0;font-size:16px;line-height:1.55;max-width:22em}
.era .era-n{font-size:14px}
.era.on{color:var(--ink)}
.js-io .hist.reveal .yr-svg{clip-path:inset(0 0 0 100%);transition:clip-path 1.1s cubic-bezier(.65,0,.35,1) .1s}
.js-io .hist.reveal.in-view .yr-svg{clip-path:inset(0 0 0 0)}
@media (max-width:860px){.eras{grid-template-columns:minmax(0,1fr);row-gap:28px}.yr-lab{display:none}}
.facts-2{grid-template-columns:repeat(2,minmax(0,1fr))}
@media (max-width:900px){.facts-2{grid-template-columns:minmax(0,1fr)}}
.shop{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:32px}
.shop .photo{max-width:none}
@media (max-width:860px){.shop{grid-template-columns:minmax(0,1fr)}}
.posters li{display:grid;grid-template-columns:9em minmax(0,1fr);gap:16px;align-items:baseline}
.posters .py{font-family:var(--mono);font-size:13px;color:var(--graphite)}
</style>

---
// A product photo on a still bolt-circle station: rings, graduations and centerlines. The plate turns with the scroll.
interface Props { src: string; alt: string }
const { src, alt } = Astro.props;
---

<div class="stage-s"><svg class="spin" viewBox="0 0 1000 1000" aria-hidden="true"><circle cx="500" cy="500" r="470" class="pl-ring"></circle><circle cx="500" cy="500" r="452" class="pl-ring"></circle><circle cx="500" cy="500" r="330" class="pl-pitch"></circle><circle cx="500" cy="500" r="486" class="pl-tick" stroke-width="12" stroke-dasharray="0.6 7.8823" stroke-dashoffset="0.3"></circle><circle cx="500" cy="500" r="482" class="pl-tick" stroke-width="20" stroke-dasharray="0.9 83.2249" stroke-dashoffset="0.45"></circle><line x1="0" y1="500" x2="1000" y2="500" class="pl-cl"></line><line x1="500" y1="0" x2="500" y2="1000" class="pl-cl"></line></svg><img src={src} alt={alt} loading="lazy" /></div>

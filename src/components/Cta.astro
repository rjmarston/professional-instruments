---
// The closing call to action. Words default to src/data/site.ts (cta); pages can pass their own.
import { cta, urls } from '../data/site';
import Button from './Button.astro';
import PlateArc from './PlateArc.astro';

interface Props { title?: string; text?: string }
const { title = cta.title, text = cta.text } = Astro.props;
---

<section class="cta wrap" aria-labelledby="cta-h">
  <PlateArc class="cta-arc" />
  <div class="in">
    <h2 id="cta-h" set:html={title} />
    <p>{text}</p>
    <div class="cta-a"><Button label={cta.button} href={urls.quote} /></div>
  </div>
</section>

<style is:global>
/* closing call to action */
.cta{position:relative;overflow:hidden;margin-top:128px}
.cta .in{position:relative;z-index:1;padding-block:112px 120px;display:flex;flex-direction:column;gap:28px;align-items:flex-start}
.cta h2{margin:0;max-width:14em;font-size:clamp(36px,4.2vw,60px);line-height:1.02;font-weight:500;letter-spacing:-.04em}
.cta p{margin:0;max-width:32em;color:var(--graphite)}
.cta-a{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px}
.cta-arc{position:absolute;top:56px;right:max(32px,calc((100% - 1360px)/2));height:calc(100% - 112px);width:auto;aspect-ratio:1/1;pointer-events:none;will-change:transform}
@media (min-width:1200px){.cta-arc{right:max(40px,calc((100% - 1360px)/2))}}
@media (max-width:1100px){.cta-arc{opacity:.45}}
@media (max-width:860px){.cta-arc{top:32px;right:16px;height:112px;opacity:.8}.cta .in{padding-top:176px}}
</style>

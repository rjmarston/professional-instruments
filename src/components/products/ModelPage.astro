---
// One model's page: hero with key figures, then overview, specifications, instructions, drawing and
// downloads, options and related models. Sections without data in the model file are left out.
// Every page in src/data/models uses this template (see src/pages/products/[...slug].astro).
import Base from '../../layouts/Base.astro';
import Subnav from '../Subnav.astro';
import SectionHead from '../SectionHead.astro';
import Facts from '../Facts.astro';
import Button from '../Button.astro';
import ArrowLink from '../ArrowLink.astro';
import TickRule from '../TickRule.astro';
import Arrow from '../Arrow.astro';
import Value from '../Value.astro';
import Disc from '../Disc.astro';
import type { Model } from '../../data/models/types';
import { modelHref } from '../../data/products';
import { site, urls } from '../../data/site';

interface Props { model: Model }
const { model } = Astro.props;

// Search engines' product data, built from the specification figures (metric, first column).
const properties = (model.specs ?? []).flatMap((block) =>
  block.rows.filter((r) => !r.text).flatMap((r) => {
    const v = r.values[0];
    const m = (Array.isArray(v) ? v[1] : v).match(/^([\d.,]+)\s*(.+)$/);
    if (!m) return [];
    const name = block.columns ? `${block.title}, ${r.label.toLowerCase()}, ${block.columns[0].toLowerCase()}` : `${block.title}, ${r.label.toLowerCase()}`;
    return [{ '@type': 'PropertyValue', name, value: m[1].replace(/,/g, ''), unitText: m[2] }];
  }),
);
const product = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: model.name,
  sku: model.sku,
  category: model.schema.category,
  description: model.seoDescription,
  image: new URL(model.image.src, Astro.site).toString(),
  ...(model.schema.brand && { brand: { '@type': 'Brand', name: model.schema.brand } }),
  manufacturer: { '@type': 'Organization', name: site.name, url: Astro.site?.toString() },
  ...(properties.length && { additionalProperty: properties }),
};

const hasOverview = model.overview.length > 0 || !!model.applications?.length;
const sections = [
  hasOverview && { label: 'Overview', id: 'overview' },
  model.specs && { label: 'Specifications', id: 'specs' },
  model.instructions && { label: 'Instructions', id: 'instructions' },
  { label: model.drawing ? 'Drawing and downloads' : 'Downloads', id: 'drawing' },
  model.options?.length && { label: 'Options', id: 'options' },
  model.related?.length && { label: 'Related models', id: 'related' },
].filter(Boolean) as { label: string; id: string }[];
const tall = model.drawing && model.drawing.height > model.drawing.width;
const hasUnits = [...model.facts.map((f) => f.value), ...(model.specs ?? []).flatMap((b) => b.rows.flatMap((r) => r.values))].some(Array.isArray);
---

<Base title={model.seoTitle} description={model.seoDescription} active="products" ogType="product" jsonLd={[product]} cta={model.cta}>
  <section class="pd-hero wrap" aria-labelledby="pd-h">
    <div class="in">
      <div class="pd-t">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span class="sep" aria-hidden="true">/</span>
          <a href={urls.products}>Products</a><span class="sep" aria-hidden="true">/</span>
          {model.family && <><a href={model.family.href}>{model.family.name}</a><span class="sep" aria-hidden="true">/</span></>}
          <span aria-current="page">{model.sku}</span>
        </nav>
        <h1 id="pd-h">{model.name}</h1>
        <p class="lede">{model.lede}</p>
        <Facts items={model.facts} class={`pd-facts pd-facts-${model.facts.length}`} />
        <div class="pd-b">
          <Button label="Request a quote" href={urls.quote} />
          <Button label={model.brochure.label} href={model.brochure.href} kind="line" />
        </div>
      </div>
      <div class="pd-v" aria-hidden="true"><Disc /><img src={model.image.src} alt="" width={model.image.width} height={model.image.height} /></div>
    </div>
  </section>

  <Subnav units={hasUnits} items={sections} />

  {hasOverview && (
    <section id="overview" class="sec sec-first anchor wrap" aria-labelledby="ov-h">
      <div class="in">
        <SectionHead id="ov-h" title="Overview" />
        <div class="ov">
          <div class="ov-t">{model.overview.map((p) => <p>{p}</p>)}</div>
          {model.applications?.length && (
            <div>
              <h3 class="lst-h">Applications</h3>
              <ul class="lst">{model.applications.map((a) => <li>{a}</li>)}</ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {model.specs && (
    <section id="specs" class="sec anchor wrap" aria-labelledby="sp-h">
      <div class="in">
        <SectionHead id="sp-h" title="Specifications" intro={model.specsIntro} />
        <div class="sp-g">
          {model.specs.map((block) => (
            <div class="sp">
              <div class="sp-h"><h3>{block.title}</h3>{block.columns?.map((c) => <span>{c}</span>)}</div>
              {block.rows.map((r) => (
                <div class:list={['sp-r', { two: r.values.length === 2, txt: r.text }]}>
                  <span class="k">{r.label}</span>
                  {r.values.map((v) => <span class="v"><Value v={v} /></span>)}
                </div>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {model.instructions && (
    <section id="instructions" class="sec anchor wrap" aria-labelledby="in-h">
      <div class="in">
        <SectionHead id="in-h" title={model.instructions.title} />
        <ol class="steps">{model.instructions.steps.map((s) => <li>{s}</li>)}</ol>
      </div>
    </section>
  )}

  <section id="drawing" class="sec anchor wrap" aria-labelledby="dr-h">
    <div class="in">
      <SectionHead id="dr-h" title={model.drawing ? 'Drawing and downloads' : 'Downloads'} intro={model.drawing?.intro} />
      {model.drawing && (
        <figure class:list={['photo dr', { tall }]}><div class="frame"><img src={model.drawing.src} alt={model.drawing.alt} width={model.drawing.width} height={model.drawing.height} loading="lazy" /></div></figure>
      )}
      <div class="docs">
        <h3 class="lst-h">Downloads (PDF)</h3>
        <ul class="docs-l">{model.downloads.map((d) => <li><a href={d.href}>{d.name}<Arrow /></a></li>)}</ul>
      </div>
    </div>
  </section>

  {model.options?.length && (
    <section id="options" class="sec anchor wrap" aria-labelledby="op-h">
      <div class="in">
        <SectionHead id="op-h" title="Options" intro={model.optionsIntro} />
        <div class="grid4">{model.options.map((o) => <div class="mini"><TickRule /><h3>{o.title}</h3><p>{o.text}</p></div>)}</div>
      </div>
    </section>
  )}

  {model.related?.length && (
    <section id="related" class="sec anchor wrap" aria-labelledby="rl-h">
      <div class="in">
        <SectionHead id="rl-h" title="Related models" />
        <div class="grid3">
          {model.related.map((r) => {
            const href = modelHref(r.sku);
            return (
              <div class="mini">
                <TickRule /><h3>{r.sku}</h3><p>{r.text}</p>
                {r.rows.length > 0 && <dl>{r.rows.map(([k, v]) => <div><dt>{k}</dt><dd><Value v={v} /></dd></div>)}</dl>}
                {href && <ArrowLink label={`View the ${r.sku}`} href={href} />}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}
</Base>

<style is:global>
.pd-hero .in{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center;padding-block:40px 96px}
.pd-t{display:flex;flex-direction:column;min-width:0}
.pd-t h1{margin:72px 0 0;font-size:clamp(48px,5.6vw,84px);line-height:1;font-weight:500;letter-spacing:-.045em;animation:rise .9s cubic-bezier(.2,0,0,1) .1s both}
.pd-t .lede{margin:28px 0 0;max-width:26em;font-size:clamp(18px,1.45vw,21px);line-height:1.55;color:var(--graphite);animation:rise .9s cubic-bezier(.2,0,0,1) .22s both}
.pd-facts{margin-top:48px}
.pd-facts-4{grid-template-columns:repeat(4,minmax(0,1fr))}
.pd-facts .n{font-size:clamp(16px,1.35vw,20px);white-space:nowrap}
.pd-b{display:flex;flex-wrap:wrap;gap:12px;margin-top:44px}
.pd-v{position:relative;aspect-ratio:1/1;max-width:620px;width:100%;justify-self:center;overflow:hidden;animation:fadein 1.2s ease .2s both}
.pd-v svg{position:absolute;inset:0;width:100%;height:100%}
.pd-v img{position:absolute;left:52%;top:50%;transform:translate(-50%,-50%);width:58%;height:auto}
@media (max-width:960px){.pd-hero .in{grid-template-columns:minmax(0,1fr)}.pd-facts-4{grid-template-columns:repeat(2,minmax(0,1fr))}.pd-facts-4 .fact:nth-child(3){border-left:none;padding-left:0}.pd-v{max-width:440px}}
@media (max-width:900px){.pd-facts-3{grid-template-columns:minmax(0,1fr)}}
@media (prefers-reduced-motion:reduce){.pd-t h1,.pd-t .lede,.pd-v{animation:none}}
.ov{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:113px;row-gap:40px}
.ov-t{display:flex;flex-direction:column;gap:20px;font-size:17px;line-height:1.65}
.ov-t p{margin:0;max-width:34em}
@media (max-width:960px){.ov{grid-template-columns:minmax(0,1fr)}}
.sp-g{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);column-gap:113px;row-gap:56px}
@media (max-width:860px){.sp-g{grid-template-columns:minmax(0,1fr)}}
.sp-h{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:end;gap:24px;padding-bottom:10px;border-bottom:1px solid var(--ink)}
.sp-h h3{margin:0;font-size:18px;font-weight:500;letter-spacing:-.01em}
.sp:has(.two) .sp-h{grid-template-columns:minmax(0,1fr) 9.5em 9.5em}
.sp-h span{font-size:12px;font-weight:600;color:var(--graphite);text-align:right}
.sp-r{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px;padding:12px 0;border-bottom:.5px solid var(--hair);align-items:baseline}
.sp-r.two{grid-template-columns:minmax(0,1fr) 9.5em 9.5em}
.sp-r .k{font-size:15px}
.sp-r .v{font-family:var(--mono);font-size:14px;text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.sp-r.txt{grid-template-columns:minmax(7em,auto) minmax(0,1fr)}
.sp-r.txt .v{font-family:var(--sans);font-size:15px;white-space:normal}
.steps{margin:0;padding:0;list-style:none;counter-reset:step;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:28px 32px}
.steps li{counter-increment:step;display:flex;flex-direction:column;gap:10px;padding-top:14px;border-top:.5px solid var(--hair);font-size:16px;line-height:1.55;max-width:30em}
.steps li::before{content:counter(step,decimal-leading-zero);font-family:var(--mono);font-size:13px;color:var(--graphite)}
.dr{max-width:none}
.dr.tall{max-width:820px}
.dr .frame{background-color:var(--white)}
.dr .frame img{aspect-ratio:auto;object-fit:contain}
.grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr));gap:40px 32px}
</style>

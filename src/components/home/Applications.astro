---
import SectionHead from '../SectionHead.astro';
import TickRule from '../TickRule.astro';
import Arrow from '../Arrow.astro';
import { applications } from '../../data/home';
import { notBuilt } from '../../data/site';
---

<section id="applications" class="sec wrap" aria-labelledby="app-h">
  <div class="in">
    <SectionHead id="app-h" title={applications.title} />
    <div class="apps">
      {applications.items.map((a) => (
        <a href={notBuilt} class="app" id={`app-${a.slug}`}><TickRule /><span class="app-n">{a.name}</span><span class="app-d">{a.desc}</span></a>
      ))}
      <a href={applications.other.href} class="app app-all"><TickRule /><span class="app-n">{applications.other.title} <Arrow /></span><span class="app-d">{applications.other.desc}</span></a>
    </div>
  </div>
</section>

<style is:global>
/* applications */
.apps{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:40px 32px}
.app{display:flex;flex-direction:column;gap:10px;text-decoration:none;min-width:0;scroll-margin-top:40px}
.app .tickrule{margin-bottom:8px}
.app-n{font-size:20px;line-height:1.25;font-weight:500;letter-spacing:-.015em}
.app-d{font-size:14px;line-height:1.5;color:var(--graphite)}
.app:hover .app-n{color:var(--red)} .app:hover .tr-major{stroke:var(--red)}
.app-all .app-n{display:inline-flex;align-items:center;gap:10px}
</style>
